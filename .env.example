# =====================================================================
#  Configuración del Sistema Central de Gestión Operativa · Campuslands
#  1. Copia este archivo como .env   (cp .env.example .env)
#  2. Cambia las claves y configura el proveedor de IA autorizado.
#  El archivo .env NO se sube al repositorio (está en .gitignore).
# =====================================================================

# --- Base de datos (PostgreSQL) ----------------------------------------
DB_NAME=campus
DB_USER=campus
DB_PASSWORD=cambia-esta-clave

# --- n8n -----------------------------------------------------------------
# Clave con la que n8n cifra las credenciales guardadas. Usa un texto largo
# y aleatorio (por ejemplo: openssl rand -hex 32). No la cambies después del
# primer arranque; si lo haces, borra el volumen: docker compose down -v
N8N_ENCRYPTION_KEY=cambia-esta-clave-larga-y-aleatoria

# --- Inteligencia artificial -----------------------------------------------
# Usa SOLO el proveedor autorizado para la jornada.

# Opción A · Claude (API de Anthropic)
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_API_KEY=
# Esfuerzo de razonamiento: low (rápido, recomendado), medium, high
AI_EFFORT=low
# Si Claude rechaza una solicitud por políticas, la API la reintenta con el
# modelo de respaldo recomendado. Escribe "none" para desactivarlo.
ANTHROPIC_FALLBACKS=default

# Opción B · Modelo local o API compatible con OpenAI (Ollama, LM Studio, vLLM...)
# AI_PROVIDER=openai
# AI_MODEL=llama3.2
# AI_BASE_URL=http://host.docker.internal:11434/v1   # Ollama instalado en el equipo
# AI_BASE_URL=http://ollama:11434/v1                 # Ollama del perfil "ia-local"
# AI_API_KEY=                                        # vacío si el servidor no la pide
# AI_JSON_MODE=json_schema                           # json_schema | json_object | none

# Tiempo máximo de espera de la IA, en milisegundos
AI_TIMEOUT_MS=90000

# --- Puertos en el equipo ----------------------------------------------------
FRONTEND_PUERTO_HOST=8080
N8N_PUERTO_HOST=5678
DB_PUERTO_HOST=5433
